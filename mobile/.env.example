# Android emulator: 10.0.2.2 aliases the host machine's localhost.
# Physical device on the same lab network: use the Ubuntu Server's LAN IP, e.g.
# http://192.168.1.100 (through nginx, port 80/443) or http://192.168.1.100:8000
# (direct to the backend, dev only). Never hard-code this — see app.json "extra.apiUrl"
# and src/api/client.ts, which reads it via expo-constants.
EXPO_PUBLIC_API_URL=http://10.0.2.2:8000
