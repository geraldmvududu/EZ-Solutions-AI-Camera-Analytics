# Environment
.env
.env.local
*.env

# Data volumes (real recordings/snapshots/db files must never be committed)
# NOTE: data/postgres/ deliberately has NO .gitkeep exception — Postgres's initdb
# refuses to initialize a data directory that isn't completely empty, even if the
# only thing in it is a hidden placeholder file. Keep this directory git-empty.
data/postgres/*
data/recordings/*
data/snapshots/*
data/uploads/*
data/models/*
data/logs/*
data/nginx-certs/*
!data/recordings/.gitkeep
!data/snapshots/.gitkeep
!data/uploads/.gitkeep
!data/models/.gitkeep
!data/logs/.gitkeep
backups/

# Large binary assets
models/*.pt
models/*.onnx
models/*.weights
videos/*.mp4
videos/*.avi
videos/*.mov
!videos/.gitkeep
!models/.gitkeep

# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.pytest_cache/
.mypy_cache/
.coverage
htmlcov/
*.db
*.db-journal
uvicorn_out.log
uvicorn_err.log
engine_out.log
engine_err.log

# Node
node_modules/
dist/
build/
.vite/
*.tsbuildinfo

# Mobile
mobile/.expo/
mobile/node_modules/

# IDE / OS
.vscode/
.idea/
.DS_Store
Thumbs.db

# Claude Code session runtime artifacts
.claude/scheduled_tasks.lock

# Logs
*.log
npm-debug.log*

# Docker
docker-compose.override.yml

# Secrets / certs
*.pem
*.key
!nginx/certs/.gitkeep
