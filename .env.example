# ============================================================
# EZ Solutions AI Camera Analytics Platform - Environment Config
# Copy this file to .env and set real values before deployment.
# NEVER commit the real .env file.
# ============================================================

# ---- General ----
ENVIRONMENT=development
TZ=UTC

# ---- Database (PostgreSQL) ----
# POSTGRES_PASSWORD is embedded directly into a connection URL (see docker-compose.yml)
# without URL-encoding. Avoid @ : / ? # % [ ] in this password — a stray "@", for
# example, breaks the user:password@host parsing and the backend fails to connect
# with a confusing "Name or service not known" error. Letters, numbers, and -_. are safe.
POSTGRES_USER=ezsolutions
POSTGRES_PASSWORD=change_me_strong_password
POSTGRES_DB=ez_camera_analytics
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg://ezsolutions:change_me_strong_password@postgres:5432/ez_camera_analytics

# ---- Redis ----
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_URL=redis://redis:6379/0

# ---- JWT / Auth ----
# Generate strong random secrets, e.g.: python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET=change_me_generate_a_long_random_secret
JWT_REFRESH_SECRET=change_me_generate_a_different_long_random_secret
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=15
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# ---- Storage paths (mounted volumes inside containers) ----
STORAGE_PATH=/data
RECORDING_PATH=/data/recordings
SNAPSHOT_PATH=/data/snapshots
UPLOAD_PATH=/data/uploads
AI_MODEL_PATH=/data/models

# ---- AI Engine ----
AI_CONFIDENCE_THRESHOLD=0.5
AI_DEVICE=cpu
AI_DEFAULT_FPS=5
AI_MODEL_NAME=yolov8n
AI_ENGINE_STREAM_URL=http://ai-engine:8090

# ---- URLs ----
API_URL=http://localhost:8000
FRONTEND_URL=http://localhost:3000
MOBILE_API_URL=http://192.168.1.100:8000

# ---- Encryption (for camera credentials at rest) ----
CREDENTIAL_ENCRYPTION_KEY=change_me_generate_a_fernet_key

# ---- Facial Recognition & Identity Analytics ----
# FACE_EMBEDDING_ENCRYPTION_KEY must be DIFFERENT from CREDENTIAL_ENCRYPTION_KEY above
# — a leaked camera-credential key must not also expose biometric templates. Generate
# both the same way: python -c "import secrets; print(secrets.token_urlsafe(64))"
FACE_RECOGNITION_ENABLED=true
FACE_MATCH_THRESHOLD=0.85
FACE_MIN_QUALITY=0.70
FACE_EVENT_COOLDOWN=30
FACE_RETENTION_DAYS=90
FACE_IMAGE_RETENTION_DAYS=30
FACE_EMBEDDING_ENCRYPTION_KEY=change_me_generate_a_different_fernet_key
FACE_MODEL_VERSION=lbph-v1
FACE_PATH=/data/faces

# ---- Initial tenant / bootstrap admin (used only by scripts/bootstrap_admin.py) ----
INITIAL_TENANT_NAME="EZ Solutions"
BOOTSTRAP_ADMIN_EMAIL=admin@ezsolutions.local
BOOTSTRAP_ADMIN_PASSWORD=change_me_on_first_login

# ---- CORS ----
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# ---- Event-First Cloud Storage (sections 9/29) ----
# S3_ENDPOINT_URL points at the local MinIO service (docker-compose.yml already sets
# this to http://minio:9000 for backend/ai-engine/worker) — leave it BLANK/unset in
# real AWS so boto3 falls back to the real regional S3 endpoint for AWS_REGION
# instead. AWS_ACCESS_KEY_ID/AWS_SECRET_ACCESS_KEY are MinIO's root credentials in
# dev; use a real IAM access key scoped to AWS_S3_BUCKET only in production — never
# reuse a broader-privileged AWS credential here.
S3_ENDPOINT_URL=http://minio:9000
# The address a real user's BROWSER can reach when the backend hands out a presigned
# evidence URL — this is NOT the same as S3_ENDPOINT_URL above (that's the internal
# Docker hostname, unreachable from outside the Docker network). The default below
# only works when Docker and the browser share one machine (pure local dev). Deploying
# to a real VM or server? Set this to that machine's real reachable address, e.g.
# S3_PUBLIC_ENDPOINT_URL=https://203.0.113.10:9000 — the same customization API_URL/
# FRONTEND_URL below already need per deployment. Leave BLANK in real AWS (same as
# S3_ENDPOINT_URL) since S3's public regional endpoint is reachable from anywhere.
S3_PUBLIC_ENDPOINT_URL=http://localhost:9000
AWS_ACCESS_KEY_ID=minioadmin
AWS_SECRET_ACCESS_KEY=minioadmin
AWS_REGION=us-east-1
AWS_S3_BUCKET=ez-camera-evidence
